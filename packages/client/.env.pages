VITE_BASE_PATH=/time-is-money/

# Served as a normal page at a stable URL, so lobby invites can be real links.
VITE_INVITE_MODE=link

# This is a real deployment build (unlike the plain .env, which points at
# localhost for dev) — point it at the live server so the GitHub Pages
# build doesn't try to reach your machine.
VITE_SERVER_URL=https://time-is-money-server.fly.dev
