# itch.io build. The game runs inside an iframe on html-classic.itch.zone, so
# window.location is the raw asset host rather than a page anyone can visit —
# and itch doesn't forward the parent page's hash into the frame. Invite links
# are therefore useless here: share the bare lobby code instead.
VITE_INVITE_MODE=code

# Same live server as the Pages build, so an itch player and a Pages player
# who swap a lobby code end up in the same lobby.
VITE_SERVER_URL=https://time-is-money-server.fly.dev
